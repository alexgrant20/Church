DATABASE_URL=postgres://churchapp:churchapp@127.0.0.1:55432/churchapp_dev
TEST_DATABASE_URL=postgres://churchapp:churchapp@127.0.0.1:55433/churchapp_test
SESSION_COOKIE_NAME=churchapp_session
ORIGIN=http://localhost:5173
NODE_ENV=development
# Production requires NODE_ENV=production and MESSAGE_TRANSPORT=live with all WhatsApp and SMTP values below.

# Each: openssl rand -base64 32
NIK_ENCRYPTION_KEY=
HMAC_KEY=

# Message delivery: "log" writes messages to MESSAGE_LOG_FILE (or console); "live" sends them.
MESSAGE_TRANSPORT=log
# Log transport output file, one JSON line per message. Unset logs to the console.
MESSAGE_LOG_FILE=
# Failed logins per identifier before a 2 minute block.
LOGIN_MAX_FAILED_ATTEMPTS=5
# WhatsApp Cloud API (Meta). Required when MESSAGE_TRANSPORT=live.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# SMTP fallback for email. Required when MESSAGE_TRANSPORT=live.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
